								<option label="SVG" value="SVG" />
								<option label="JPG" value="JPG" />
							</dropdown>
							<row id="row_sW12001004">
								<spinbox label="Width (px)" id="dev_width" initial="1200" min="100" max="4000" />
								<spinbox label="Height (px)" id="dev_height" initial="1000" min="100" max="4000" />
							</row>
							<column id="clm_sR15050600">
								<spinbox label="Resolution (ppi)" id="dev_res" initial="150" min="50" max="600" />
								<dropdown id="dev_bg" label="Background Override">
									<option label="Follow Dark Mode settings" value="auto" checked="true" />
									<option label="Transparent" value="transparent" />
									<option label="White" value="white" />
								</dropdown>
							</column>
						</frame>
						<saveobject label="Save Plot Object" checkable="true" checked="true" initial="p" id="save_plot_obj" />
