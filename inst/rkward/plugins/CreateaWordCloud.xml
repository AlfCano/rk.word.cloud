					</column>
				</tab>
				<tab label="Appearance" id="tab_Appearnc">
					<column id="clm_dCSCDCHDTP">
						<dropdown id="drop_shape" label="Cloud Shape">
							<option label="Circle (Default)" value="circle" checked="true" />
							<option label="Cardioid / Heart" value="cardioid" />
							<option label="Diamond" value="diamond" />
							<option label="Triangle" value="triangle-forward" />
							<option label="Pentagon" value="pentagon" />
							<option label="Star" value="star" />
						</dropdown>
						<dropdown id="drop_pal" label="Color Palette">
							<option label="Spectral (Highly Recommended)" value="Spectral" checked="true" />
							<option label="Dark2" value="Dark2" />
							<option label="Set1" value="Set1" />
							<option label="Set2" value="Set2" />
							<option label="Paired" value="Paired" />
							<option label="Blues" value="Blues" />
							<option label="Reds" value="Reds" />
						</dropdown>
						<dropdown id="drop_rot" label="Word Rotation">
							<option label="Horizontal Only (Clean)" value="horizontal" checked="true" />
							<option label="Classic (Horizontal &amp; 90° Vertical)" value="classic" />
							<option label="Chaotic (Random Angles)" value="chaotic" />
						</dropdown>
						<checkbox id="chk_dark" label="Dark Mode (Black Background)" value="1" value_unchecked="0" />
						<frame label="Word Size Settings" id="frm_WrdSzStt">
							<row id="row_sMS3120MS1">
								<spinbox label="Min Size" id="spin_size_min" initial="3" min="1" max="20" />
								<spinbox label="Max Size" id="spin_size_max" initial="15" min="5" max="60" />
							</row>
						</frame>
						<stretch />
					</column>
				</tab>
				<tab label="Output &amp; Export" id="tab_OtptExpr">
