	<dialog label="Generate Word Cloud">
		<row id="row_vDIDITCMTN">
			<varselector id="v_sel_corpus" />
			<tabbook>
				<tab label="Data Input" id="tab_DataInpt">
					<column id="clm_vTCMTN1501">
						<varslot id="inp_corpus" label="Text Corpus (tm object from rk.text.mining)" source="v_sel_corpus" required="true" />
						<spinbox label="Maximum words to display (Top N)" id="spin_topn" initial="150" min="10" max="2000" />
						<spinbox label="Minimum word frequency" id="spin_minfreq" initial="2" min="1" max="5000" />
